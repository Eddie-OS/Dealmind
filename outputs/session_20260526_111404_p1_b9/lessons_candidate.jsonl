{"type": "reusable_tactic", "session_id": "session_20260526_111404_p1_b9", "persona_id": "db:1", "outcome": "WALK_AWAY", "name": "数字直给法", "condition": "当客户要求具体数字时，立即给出明确数字，即使需要从内部政策中提取。", "example": "客户问保底回收百分比，直接回答“80%”而非“具体数据”。", "status": "candidate", "exported_at": "20260526_112012"}
