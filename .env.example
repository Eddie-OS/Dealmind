OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-pro
TEMPERATURE=1.0
MAX_RETRIES=2

# 登录鉴权：保护所有 /api 与 /ws。改密码后所有人需重新登录。
DM_AUTH_USERNAME=admin
DM_AUTH_PASSWORD=789123
# 仅跨域部署才需要：允许的前端来源，逗号分隔，如 https://your.domain
# 同源（Caddy 静态 + /api 同域）部署时留空即可。
DM_CORS_ORIGINS=

# —— 小内存机器稳定性护栏 ——
# 同时进行的实时会话上限（超过直接 429 让前端稍候再试，防 OOM 卡死整机）。
# 2GB 机器建议 2~3。
DM_MAX_CONCURRENT_SESSIONS=3
# 开机预加载 embedding 模型（把内存峰值挪到启动时）。设 0 关闭（本地开发可关）。
DM_PRELOAD_EMBEDDER=1

# 销冠仍用 MODEL_NAME（建议 deepseek-v4-pro）；以下辅助链路默认 flash
AUX_MODEL_NAME=deepseek-v4-flash

# 批量模拟 SLA（目标：44 场 ≤2h）
BATCH_SESSION_CONCURRENCY=8
BATCH_JUDGE_INTERVAL=6
BATCH_MEMORY_INTERVAL=6

# 分析报告 SLA（目标：745 turn ≤2h）
ANALYSIS_TURN_WORKERS=16
LLM_MAX_IN_FLIGHT=12
