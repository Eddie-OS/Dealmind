# ===== 密钥 / 环境变量 =====
.env
.env.*
!.env.example

# ===== Python =====
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Node / 前端 =====
node_modules/
web/node_modules/
web/dist/
dist/
*.local

# ===== 编辑器 / IDE =====
.idea/
.vscode/
.cursor/

# ===== 部署工具二进制（用系统 ssh/scp 即可）=====
tools/*.exe

# ===== 本地调试 dump（含会话内容，勿入库）=====
scripts/_recent_sessions_dump.txt
scripts/_recent_sessions_dump*.txt

# ===== Codegraph 索引 =====
.codegraph/

# ===== 运行时产物 / 大文件 =====
logs/
terminals/
tmp/

# ===== 数据库 =====
# 原始 .db 单文件可超 GitHub 100MB 限制；入库压缩包 data/*.db.gz，部署时用 scripts/restore_conversations_db.py 解压
data/*.db
data/*.db-journal
!data/*.db.gz
data/*.sqlite

# ===== 归档 / 大体积素材 =====
*.zip
*.rar
*.7z
__MACOSX/
训练文件/

# ===== 系统垃圾 =====
.DS_Store
Thumbs.db
